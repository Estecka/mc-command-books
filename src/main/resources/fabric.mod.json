{
	"schemaVersion": 1,
	"id": "commandbooks",
	"version": "${version}",

	"name": "Command books",
	"description": "Save commands and run them on a simple item use.",
	"authors": [
		"Estecka"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/command-books",
		"sources": "https://github.com/Estecka/mc-command-books",
		"issues":  "https://github.com/Estecka/mc-command-books/issues"
	},
	"license": "MIT",

	"icon": "assets/cmdbook/icon.png",

	"environment": "*",
